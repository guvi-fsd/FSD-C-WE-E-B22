								"exec": [
									"pm.test('Status is 200', function () {",
									"  pm.response.to.have.status(200);",
									"});",
									"",
									"try {",
									"  const data = pm.response.json();",
									"  if (data && data.token) {",
									"    pm.environment.set('jwt', data.token);",
									"    pm.test('Saved token to {{jwt}}', function () { pm.expect(pm.environment.get('jwt')).to.eql(data.token); });",
									"  }",
									"} catch (e) {",
									"  console.log('No JSON body to parse');",
									"}"
