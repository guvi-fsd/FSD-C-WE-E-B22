			"name": "Bookings / Create (DB + Mailtrap email)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.environment.get('bookingStartISO')) {",
							"  pm.environment.set('bookingStartISO', new Date(Date.now() + 48*60*60*1000).toISOString());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
