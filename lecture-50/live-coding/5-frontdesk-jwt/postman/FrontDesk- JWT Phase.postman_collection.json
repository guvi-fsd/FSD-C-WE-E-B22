		{
			"name": "Bookings / List by Range (role-aware, DB)",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"if (!pm.environment.get('fromISO')) {",
							"  pm.environment.set('fromISO', new Date(Date.now() - 24*60*60*1000).toISOString());",
							"}",
							"if (!pm.environment.get('toISO')) {",
							"  pm.environment.set('toISO', new Date(Date.now() + 7*24*60*60*1000).toISOString());",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/bookings?from={{fromISO}}&to={{toISO}}",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"bookings"
					],
					"query": [
						{
							"key": "from",
							"value": "{{fromISO}}"
						},
						{
							"key": "to",
							"value": "{{toISO}}"
						}
					]
				}
			},
